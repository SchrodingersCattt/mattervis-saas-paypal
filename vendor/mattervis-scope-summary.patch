diff --git a/mat_viewer/loader/bundle_builder.py b/mat_viewer/loader/bundle_builder.py
index 30262a8..ae15a46 100644
--- a/mat_viewer/loader/bundle_builder.py
+++ b/mat_viewer/loader/bundle_builder.py
@@ -151,0 +152,11 @@ def build_loaded_crystal_from_atoms(
+    # Use the same source-level disorder fact as the scientific inspection
+    # tool. The formula-unit view can omit disordered sites entirely.
+    from molcrys_kit.analysis import summarize_structure
+
+    try:
+        initial_scene["source_has_disorder"] = bool(
+            summarize_structure(molcrys_analysis.crystal)["disorder"]["has_disorder"]
+        )
+    except Exception:
+        # Missing source information must not be reported as an ordered source.
+        initial_scene["source_has_disorder"] = None
